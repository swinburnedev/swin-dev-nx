registry=https://registry.npmjs.org

# Expose Astro dependencies for `pnpm` users
shamefully-hoist=true

# ==========================================
# GitHub Packages Configuration
# ==========================================
# Uncomment and configure for GitHub Packages (recommended)
#
# Registry URL: https://npm.pkg.github.com
#
# Setup:
# 1. Create GitHub Personal Access Token at https://github.com/settings/tokens
#    - Select scopes: write:packages, read:packages, repo
# 2. Set environment variable: export NPM_TOKEN=your_token_here
# 3. Uncomment the lines below
# 4. Run: nx build layout --configuration=production
# 5. Publish: cd dist/libs/layout && npm publish
#
# See: docs/GITHUB_PACKAGES_SETUP.md for complete guide

@swinburne-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}

